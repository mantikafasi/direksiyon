DISCORD_TOKEN=replace-with-a-new-token
# Optional: restrict slash-command sync to one guild for instant registration.
GUILD_ID=
MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
# Set this to a local HF snapshot to avoid another model lookup.
MODEL_PATH=
LOAD_4BIT=true
INJECT_MODE=residual
R_MODE=canonical
# Keep the ~1 GiB embedding table in system RAM so every layer fits on a 6 GB GPU.
# ./run.sh sets this and the context/history values below; set them here only if you run
# `python -m llmsteer.bot` directly.
EMBED_ON_CPU=true
# Only used when EMBED_ON_CPU=false.
GPU_MEMORY_GIB=5.2
CPU_OFFLOAD=true
CONTEXT_TOKENS=3072
MAX_NEW_TOKENS=160
PROBE_MAX_NEW_TOKENS=160
HISTORY_TURNS=8
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.1
ALPHA_MAX=2.5
MAX_QUEUE=4
CLEAR_HISTORY_ON_STEER=true
# Button increments on the .steer panel (1-5 positive numbers).
STEER_STEPS=0.05,0.1,0.25,0.5,0.8
